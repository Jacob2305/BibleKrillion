{
  // Node code: Vercel functions (api/), server logic (server/), shared logic (lib/), CLI scripts (scripts/).
  // NodeNext forces explicit .js import extensions so the code runs as native ESM on Vercel.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["lib", "api", "server", "scripts"],
  "exclude": ["lib/**/__tests__", "server/**/__tests__"]
}
