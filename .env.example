# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables the AI judge for unlisted answers on open-set prompts.
# Free key: https://aistudio.google.com/apikey (free-tier requests may be used by Google to improve its products).
GEMINI_API_KEY=
# Optional: Gemini model used by the judge (default gemini-3.5-flash-lite, free tier).
JUDGE_MODEL=
# Optional: AI judge calls per player per prompt (default 3) and per day for the whole app (default 500).
JUDGE_CALLS_PER_PROMPT=
JUDGE_DAILY_LIMIT=

# Optional: default PIN required to open the /host screen.
HOST_PIN=

# Optional: secret used to seal game tokens. If unset, one is derived from
# SUPABASE_SERVICE_ROLE_KEY. A deployment with neither refuses to start games.
SESSION_SECRET=

# Optional: seconds per prompt (default 25, allowed 5–120).
PROMPT_SECONDS=
